# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more information, see the following:
#   https://d.android.com/r/tools/r8/keep-rules

# The Shizuku UserService is instantiated in a separate shell process with the app APK's class loader;
# keep the entry class constructor and Stub so shrinking/obfuscation doesn't break cross-process reflection.
# LibXposed API 102 module entry: keep the XposedModule subclass and its no-arg constructor
-keep,allowoptimization,allowobfuscation public class * extends io.github.libxposed.api.XposedModule {
    public <init>();
}
-dontwarn io.github.libxposed.annotation.**

-keep class io.github.ynkcc.moredisplay.shizuku.DaemonUserService {
    public <init>(android.content.Context);
    public *;
}
-keep class io.github.ynkcc.moredisplay.shizuku.IDaemonRpc { *; }
-keep class io.github.ynkcc.moredisplay.shizuku.IDaemonRpc$* { *; }
-keep class io.github.ynkcc.moredisplay.core.** { *; }
-keep class io.github.ynkcc.moredisplay.daemon.** { *; }
-keep class io.github.ynkcc.moredisplay.dispatch.** { *; }

# The Xposed module entry is loaded reflectively by the framework (Vector / LSPosed) from the class names in META-INF/xposed/java_init.list.
# Nothing in the dex references it, so with R8 enabled the whole class would be stripped by mistake; it must be kept explicitly.
# (These classes reflect on hidden framework APIs; the framework is not in this dex, so that is unaffected.)
-keep class io.github.ynkcc.moredisplay.xposed.** { *; }
-keep class io.github.ynkcc.moredisplay.CommandActivity { *; }

# Shizuku's UserService is called across processes over Binder; keep the aidl-generated Stub/Proxy.
-keep class **$Stub { *; }
-keep class **$Stub$Proxy { *; }
